# Base URL for sitemap generation and SEO
# In production, change to your actual domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Facebook App ID for Open Graph integration
# Get your App ID from https://developers.facebook.com/apps/
# NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# Environment (production, development, or preview)
# This affects robots.txt behavior
NODE_ENV=development
