# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Never expose this key to the browser — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_SECRET_KEY=your-secret-key

# ============================================================
# Platform Admin (Phase 8)
# ============================================================
# AES-256-GCM key for encrypting platform_integrations secrets at rest.
# Generate with: openssl rand -base64 32
# MUST decode to exactly 32 bytes. Rotate via supabase/ADMIN-BOOTSTRAP.md procedure.
APP_ENCRYPTION_KEY=your-base64-32byte-key

# ============================================================
# AI Services (server-side only)
# ============================================================
# Anthropic — Claude AI for estimate generation + photo analysis
# Get from: https://console.anthropic.com -> API Keys -> Create Key
# NOTE (Phase 8): After super-admin configures this provider via /admin/integrations,
# the DB value takes precedence; this env var is only used as a local-dev fallback.
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI — Whisper API for audio transcription
# Get from: https://platform.openai.com/api-keys -> Create new secret key
# NOTE (Phase 8): After super-admin configures this provider via /admin/integrations,
# the DB value takes precedence; this env var is only used as a local-dev fallback.
OPENAI_API_KEY=your-openai-api-key

# ============================================================
# Email (server-side only)
# ============================================================
# Resend — sending estimate emails to clients
# Get from: https://resend.com/api-keys -> Create API Key
# NOTE (Phase 8): After super-admin configures this provider via /admin/integrations,
# the DB value takes precedence; this env var is only used as a local-dev fallback.
RESEND_API_KEY=your-resend-api-key

# ============================================================
# Meta WhatsApp Cloud API (Phase 40 — WA-01/WA-02/WA-04)
# ============================================================
# Meta app secret for HMAC-SHA256 webhook signature verification
META_WHATSAPP_APP_SECRET=
# Static random string for GET webhook challenge (generate with: openssl rand -hex 32)
META_WHATSAPP_VERIFY_TOKEN=
# System User permanent access token from Meta Business Suite
META_WHATSAPP_ACCESS_TOKEN=
# Meta Phone Number ID (from WhatsApp Manager > Phone Numbers)
META_WHATSAPP_PHONE_NUMBER_ID=
# Meta WhatsApp Business Account ID
META_WHATSAPP_WABA_ID=
