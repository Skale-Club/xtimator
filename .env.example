# Base URL for sitemap generation and SEO
# In production, change to your actual domain
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional: Facebook App ID for Open Graph integration
# Get your App ID from https://developers.facebook.com/apps/
# NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# Environment (production, development, or preview)
# This affects robots.txt behavior
NODE_ENV=development
