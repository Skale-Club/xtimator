# ============================================================
# Supabase
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Never expose this key to the browser — server-side only
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# AI Services (server-side only)
# ============================================================
# Anthropic — Claude AI for estimate generation + photo analysis
# Get from: https://console.anthropic.com -> API Keys -> Create Key
ANTHROPIC_API_KEY=your-anthropic-api-key

# OpenAI — Whisper API for audio transcription
# Get from: https://platform.openai.com/api-keys -> Create new secret key
OPENAI_API_KEY=your-openai-api-key

# ============================================================
# Email (server-side only)
# ============================================================
# Resend — sending estimate emails to clients
# Get from: https://resend.com/api-keys -> Create API Key
RESEND_API_KEY=your-resend-api-key
