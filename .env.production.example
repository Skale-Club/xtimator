# .env.production.example — DO NOT commit a populated .env.production
#
# Copy this file to /opt/xtimator/.env.production on the Hetzner VPS,
# then fill in real values from the listed sources. NEVER commit the
# populated file (gitleaks pre-commit hook blocks all real secret
# patterns: whsec_*, sk_(test|live)_*, sk-ant-*, signkey-prod-*, etc.).
#
# See docs/HETZNER-DEPLOY.md (Phase 68 Plan 02) for the full setup runbook.

# =========================================================================
# Supabase — managed Postgres + Auth + Storage (default)
# Source: Supabase Dashboard -> Project Settings -> API
# =========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# =========================================================================
# AI providers
# =========================================================================
# Anthropic Claude — used for estimate generation + photo analysis
# Source: console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-<your-key>

# OpenAI Whisper — used for audio transcription
# Source: platform.openai.com -> API Keys
OPENAI_API_KEY=sk-proj-<your-key>

# =========================================================================
# Email (Resend) — transactional emails (estimates, trial reminders)
# Source: resend.com -> API Keys
# =========================================================================
RESEND_API_KEY=re_<your-key>

# =========================================================================
# Stripe — billing + subscriptions
# Source: dashboard.stripe.com -> Developers -> API keys (live mode for prod)
# =========================================================================
STRIPE_SECRET_KEY=sk_live_<your-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-secret>
STRIPE_PRICE_ID_PRO_MONTHLY=price_<your-price-id>
STRIPE_PRICE_ID_BUSINESS_MONTHLY=price_<your-price-id>

# =========================================================================
# Inngest — background AI jobs (Phase 67)
# Source: app.inngest.com -> Apps -> xtimator -> Keys (production)
# =========================================================================
INNGEST_EVENT_KEY=signkey-prod-<your-event-key>
INNGEST_SIGNING_KEY=signkey-prod-<your-signing-key>

# =========================================================================
# Upstash Redis — rate limiting + WhatsApp message debounce (Phase 47-48)
# Source: console.upstash.com -> Redis -> <database> -> REST API
# =========================================================================
UPSTASH_REDIS_REST_URL=https://<your-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-rest-token>

# =========================================================================
# Storage provider (Phase 66)
#
# Default = Supabase Storage (omit STORAGE_PROVIDER or set to 'supabase').
# Set STORAGE_PROVIDER=s3 to switch to Hetzner Object Storage; see
# docs/STORAGE-MIGRATION.md for the full cutover runbook.
# =========================================================================
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://fsn1.your-objectstorage.com
# S3_REGION=fsn1
# S3_ACCESS_KEY_ID=<your-hetzner-key>
# S3_SECRET_ACCESS_KEY=<your-hetzner-secret>
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://fsn1.your-objectstorage.com

# =========================================================================
# Build / runtime metadata
# =========================================================================
# Set by the deploy script — `docker compose up` reads this for the
# /api/health response so we can verify which commit is live.
# GIT_SHA=<set-by-deploy-script>

# =========================================================================
# Caddy / TLS — these live in /opt/xtimator/.env (NOT .env.production)
# because they're consumed by docker compose / Caddy, not by the Next app.
# Listed here for completeness only; do NOT add them to this file.
# =========================================================================
# DOMAIN=xtimator.com
# ACME_EMAIL=admin@xtimator.com
