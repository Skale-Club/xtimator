# Xtimator — local development environment template.
#
# Copy this file to `.env.local` (gitignored) and fill in real values.
# NEVER commit real keys to this file — placeholders only.
# See CLAUDE.md "Secret Handling" for the full rules. The gitleaks
# pre-commit hook scans staged content for common secret shapes.

# ---- Supabase (required) ---------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_<your-anon-key>
# SUPABASE_SECRET_KEY=sb_secret_<your-service-role-key>

# ---- AI providers (all via OpenRouter) -------------------------------------
# OPENROUTER_API_KEY=sk-or-v1-<your-key>   # required — all AI (estimates, transcription, vision)
#
# Legacy direct-provider keys (no longer used by the app; kept for reference)
# ANTHROPIC_API_KEY=sk-ant-<your-key>
# OPENAI_API_KEY=sk-proj-<your-key>

# ---- Inngest (background jobs: transcription, photo analysis, notifications) -
# Local dev:  set any non-empty value AND run `npx inngest-cli@latest dev`
# Production: get the real key from https://app.inngest.com → your app → Event Keys
# INNGEST_EVENT_KEY=<your-inngest-event-key>
# INNGEST_SIGNING_KEY=signkey-prod-<your-signing-key>   # required in production

# ---- Email (Resend) --------------------------------------------------------
# RESEND_API_KEY=re_<your-key>

# ---- Stripe (billing) ------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_<your-key>
# STRIPE_WEBHOOK_SECRET=whsec_<your-secret>
# STRIPE_PRICE_PRO=price_<your-price-id>
# STRIPE_PRICE_BUSINESS=price_<your-price-id>
# STRIPE_PRICE_PRO_ANNUAL=price_<your-annual-pro-price-id>
# STRIPE_PRICE_BUSINESS_ANNUAL=price_<your-annual-business-price-id>
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_<your-secret>   # Stripe Connect webhook endpoint signing secret
# NEXT_PUBLIC_APP_URL=http://localhost:9633   # app origin for billing success/cancel URLs (dev port)

# ---- WhatsApp (Meta Cloud API) ---------------------------------------------
# WHATSAPP_VERIFY_TOKEN=<your-verify-token>
# WHATSAPP_APP_SECRET=<your-app-secret>

# ---- Storage abstraction (Phase 66 — STORAGE-05/07) ------------------------
# Default is Supabase Storage — leave STORAGE_PROVIDER UNSET for production.
# Set to 's3' ONLY for the local MinIO smoke test or future Hetzner cutover
# (see docs/STORAGE-MIGRATION.md for the full runbook).
#
# STORAGE_PROVIDER=supabase

# When STORAGE_PROVIDER=s3, the following are REQUIRED.
# Hetzner Object Storage example endpoints / regions are listed in
# docs/STORAGE-MIGRATION.md. NEVER commit real keys — placeholders only.
#
# S3_ENDPOINT=https://<your-region>.your-objectstorage.com
# S3_REGION=<your-region>
# S3_ACCESS_KEY_ID=s3_access_key_<your-key>
# S3_SECRET_ACCESS_KEY=s3_secret_<your-key>
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_URL_BASE=https://<your-region>.your-objectstorage.com

# ---- Langfuse (LLM observability) -----------------------------------------
# Traces all LLM calls (estimate generation, photo analysis, translation,
# transcription). Leave unset to silently disable — no errors thrown.
# Get keys from: https://cloud.langfuse.com -> Settings -> API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-<your-key>
# LANGFUSE_SECRET_KEY=sk-lf-<your-key>
# LANGFUSE_HOST=https://cloud.langfuse.com   # optional — defaults to cloud

# ---- Sentry (error tracking) -----------------------------------------------
# Captures unhandled 5xx errors. Leave unset to silently disable.
# Get DSN: https://sentry.io -> Project Settings -> Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://<hash>@o<org-id>.ingest.sentry.io/<project-id>
# SENTRY_ORG=<your-org-slug>
# SENTRY_PROJECT=xtimator
# SENTRY_AUTH_TOKEN=sntrys_<your-auth-token>   # build-time only (source map upload)
#
# In production (CI/GitHub Actions):
#   - NEXT_PUBLIC_SENTRY_DSN, SENTRY_ORG, SENTRY_PROJECT → GitHub Actions Variables
#   - SENTRY_AUTH_TOKEN → GitHub Actions Secret (passed as Docker build secret, never in image)
#   - Coolify only needs runtime env vars — no Sentry vars required there
