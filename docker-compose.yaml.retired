# Coolify deploys this PREBUILT image instead of building on the VPS.
# The image is built on a 16GB GitHub Actions runner and pushed to GHCR by
# .github/workflows/build-deploy.yml, so Coolify only does `docker pull` + run.
#
# Requires in Coolify (app → Configuration):
#   - Build Pack = "Docker Compose"
#   - ghcr.io pull auth (done once on the host via `docker login`, covers all
#     ghcr.io/skale-club/* images).
#   - Map the prod domain(s) to the `app` service in "Docker Compose Domains".
#
# Coolify auto-injects the app's configured environment variables into this
# service, so secrets are NOT duplicated here — only runtime hints the image
# expects are pinned.
services:
  app:
    image: ghcr.io/skale-club/xtimator:latest
    # Force a fresh pull of :latest on every deploy. Without this, Coolify/Docker
    # reuse the locally-cached :latest (the tag name never changes) and silently
    # run stale code — which froze prod on a pre-owner_phone image and broke the
    # WhatsApp inbound webhook (routing query 400'd on a dropped column).
    pull_policy: always
    restart: unless-stopped
    environment:
      - NODE_ENV=production
      - PORT=3000
      - HOSTNAME=0.0.0.0
      - APP_ORIGIN=https://xtimator.com
    ports:
      - "3000"
    # Health gate for Coolify/Traefik routing. Uses /api/health/live — a PURE
    # LIVENESS probe (no DB, no storage). Gating traffic on the deep /api/health
    # check (DB + storage) meant any transient Supabase blip flipped the
    # container to "unhealthy" and Coolify removed it from the proxy → users saw
    # "no available server" with the app running fine. The deep readiness check
    # still lives at /api/health for uptime monitors — it just must NOT gate the
    # proxy. Fast interval so a fresh deploy goes healthy within seconds.
    healthcheck:
      test: ["CMD", "node", "-e", "require('http').get('http://127.0.0.1:3000/api/health/live',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"]
      interval: 10s
      timeout: 3s
      retries: 3
      start_period: 20s
    # Give in-flight requests time to drain when the old container is replaced,
    # so a deploy swap never severs an active response mid-flight.
    stop_grace_period: 30s
